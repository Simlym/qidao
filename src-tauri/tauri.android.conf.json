{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.xiangqidao.app",
  "build": {
    "beforeDevCommand": "npm run dev:android -- --host 0.0.0.0",
    "beforeBuildCommand": "npm run build:android",
    "frontendDist": "../frontend/dist-tauri"
  },
  "app": {
    "security": {
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "android": {
      "minSdkVersion": 24
    }
  }
}
