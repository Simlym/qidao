# 复制本文件为根目录 .env 后再启动。生产环境请使用足够长的随机值。
SECRET_KEY=请替换为随机生成的长密钥

# PostgreSQL 配置。密码会用于连接串，请只使用字母、数字、下划线或连字符。
POSTGRES_DB=xiangqidao
POSTGRES_USER=xiangqidao
POSTGRES_PASSWORD=请替换为数据库强密码

# Web 默认连接同源 API；更改后需重新构建 frontend。这里不能放任何密钥。
VITE_API_BASE_URL=/api

# 网站对外监听端口
HTTP_PORT=8080
TZ=Asia/Shanghai

# 允许的前端来源（逗号分隔，不含 /api）；生产请改为实际 Web 和客户端来源。
# Windows 通常为 http://tauri.localhost；Android 通常为 https://tauri.localhost。
# 留空会全放开，生产请勿留空。
CORS_ORIGINS=http://localhost:8080,http://tauri.localhost,https://tauri.localhost

# 可选：明确指定管理员用户名；首位注册者始终成为管理员，匹配该用户名的注册者也会成为管理员。
ADMIN_USERNAME=

# 可选：AI 教练配置，也可以部署后在管理后台设置。
LLM_API_KEY=
LLM_PROTOCOL=openai_chat
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# 在线开局库：1 开启，0 关闭。
CLOUDBOOK_ENABLED=1

# 国内网络加速已在 docker-compose.yml 内置缺省值，一般无需配置；需更换时取消注释覆盖。
# IMAGE_REGISTRY：Docker Hub 镜像加速源，默认 DaoCloud；海外服务器可设 docker.io 直连官方源，
# 也可换成阿里云控制台分配的个人加速地址主机名（形如 xxxxxxxx.mirror.aliyuncs.com）。
#IMAGE_REGISTRY=docker.m.daocloud.io
# PIP_INDEX_URL：pip 源，默认阿里源；也可换清华源 https://pypi.tuna.tsinghua.edu.cn/simple
#PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# NPM_REGISTRY：npm 源，默认 npmmirror（原淘宝源）。
#NPM_REGISTRY=https://registry.npmmirror.com
